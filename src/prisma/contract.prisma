// use prisma-8

model Product{
  id  Int @id @default(autoincrement())
  name String  @unique 
  price Int
  image String @default("")
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])
}

model Category{
  id Int @id @default(autoincrement())
  name String  @unique
  products Product[]
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  sessions RefreshSessions[]
}

model RefreshSessions{
  id Int @id @default(autoincrement())
  userId Int 
  tokenHash String
  expiresAt DateTime
  createdAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}